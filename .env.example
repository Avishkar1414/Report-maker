# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://localhost:27017/reports

# Server Port
PORT=3000

# Google OAuth Web client ID (required for report API access)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Comma-separated emails allowed through the protected tunnel (one-time codes)
TUNNEL_ALLOWED_EMAIL=you@example.com,another-user@example.com

# Environment
NODE_ENV=development
