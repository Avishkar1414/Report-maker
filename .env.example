# CockroachDB Connection String
# Get this from https://cockroachlabs.com/cloud/
# Example: postgresql://user:password@cluster-id.aws-ap-south-1.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full
DATABASE_URL=postgresql://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER_ID.aws-ap-south-1.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full

# Server Port (Render will override this)
PORT=3000

# Environment
NODE_ENV=production
